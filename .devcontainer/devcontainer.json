{
  "name": "Roster (.NET 10 and SQL Server 2022)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    }
  },
  "initializeCommand": "bash .devcontainer/init-env.sh",
  "postCreateCommand": "dotnet restore Roster.sln && dotnet tool restore",
  "postStartCommand": "bash .devcontainer/start-app.sh --background",
  "forwardPorts": [5066],
  "portsAttributes": {
    "5066": {
      "label": "Roster",
      "onAutoForward": "openBrowser"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
