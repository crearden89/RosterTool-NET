{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Branding": {
    "AppName": "Roster",
    "Tagline": "Fortnightly planning & execution",
    "LogoUrl": "brand/mark.svg",
    "IconUrl": "brand/mark.svg"
  },
  "Auth": {
    "Mode": "EntraId",
    "SessionLifetime": "08:00:00",
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc"
    },
    "TierGroups": {
      "SuperUser": [ "Roster.SuperUser" ],
      "Emso": [ "Roster.EMSO" ],
      "Director": [ "Roster.DSO" ],
      "Pa": [ "Roster.PA" ],
      "Store": [ "Roster.Store" ]
    }
  },
  "Kiosk": {
    "RequireDeviceSignIn": false,
    "DeviceGroups": []
  }
}
