@* A card's own heading row: a title, and a quiet note or action on the right. *@
<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 id="@Id" class="text-base font-semibold text-[var(--ui-ink)]">@Title</h2>
    @if (Aside is not null)
    {
        <div class="text-xs text-[var(--ui-muted)]">@Aside</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? Title { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public string? Id { get; set; }
}
