@inject IOptions<BrandingOptions> Branding
@* Every page starts with it: a large bold navy title, a grey line of facts
   under it, and the page's own controls on the right (store picker, fortnight
   arrows, the primary action as a white outlined button). *@
<PageTitle>@Title · @Branding.Value.AppName</PageTitle>
<div class="mb-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h1 class="text-[28px] font-bold leading-tight tracking-tight text-[var(--ui-ink)] sm:text-[32px]">@Title</h1>
            @Badge
        </div>
        @if (Subtitle is not null)
        {
            <p class="mt-1.5 text-sm text-[var(--ui-muted)]">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="flex flex-wrap items-center gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>A line of facts, e.g. "29 team members · contracts, availability and leave".</summary>
    [Parameter] public RenderFragment? Subtitle { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>A status pill beside the title.</summary>
    [Parameter] public RenderFragment? Badge { get; set; }
}
