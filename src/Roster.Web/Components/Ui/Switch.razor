@* An on/off switch: a real control (role="switch"). Give it a label, shown or
   for screen readers only, and an OnChange (or @bind-Checked). Without one, or
   disabled, it shows the state and cannot be changed. Use it only where
   flipping it does something now. *@
<button type="button" role="switch" aria-checked="@(Checked ? "true" : "false")" aria-label="@(ShowLabel ? null : Label)"
        disabled="@Locked" @onclick="Toggle"
        class="@Ui.Cx("inline-flex items-center gap-2 rounded-full text-xs font-medium text-[var(--ui-ink)] disabled:cursor-default", Ui.FocusRing, Class)">
    <span aria-hidden="true" class="@Ui.Cx("relative inline-flex h-5 w-9 shrink-0 items-center rounded-full transition-colors", Checked ? "bg-[var(--ui-ink)]" : "bg-[var(--ui-control)]", Locked ? "opacity-60" : null)">
        <span class="@Ui.Cx("absolute h-4 w-4 rounded-full bg-white shadow-sm transition-transform", Checked ? "translate-x-[18px]" : "translate-x-0.5")"></span>
    </span>
    @if (ShowLabel)
    {
        <span>@Label</span>
    }
</button>

@code {
    [Parameter] public bool Checked { get; set; }

    /// <summary>Called with the new state when the switch is flipped.</summary>
    [Parameter] public EventCallback<bool> OnChange { get; set; }

    /// <summary>For @bind-Checked.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool Locked => Disabled || (!OnChange.HasDelegate && !CheckedChanged.HasDelegate);

    private async Task Toggle()
    {
        if (Locked) return;
        var next = !Checked;
        if (OnChange.HasDelegate) await OnChange.InvokeAsync(next);
        if (CheckedChanged.HasDelegate) await CheckedChanged.InvokeAsync(next);
    }
}
