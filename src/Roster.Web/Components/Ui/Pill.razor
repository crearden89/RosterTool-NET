@* A rounded label. (The roster grid's role badges are Badge, not this.) *@
<span title="@Title" class="@Ui.Cx("inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap", ToneClasses.Pill(Tone), Class)">@ChildContent</span>

@code {
    [Parameter] public PillTone Tone { get; set; } = PillTone.Soft;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
}
