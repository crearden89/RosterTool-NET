@* Kept exactly as the TypeScript app has it: the roster grid uses it for its
   role badges, and nothing inside the plan and roster grids may change. *@
<span class="@Ui.Cx("inline-block rounded-full px-2.5 py-0.5 text-xs font-medium", ToneClasses.Badge(Tone))">@ChildContent</span>

@code {
    [Parameter] public BadgeTone Tone { get; set; } = BadgeTone.Navy;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
