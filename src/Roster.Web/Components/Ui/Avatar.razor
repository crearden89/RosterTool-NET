@* Port of src/components/ui/primitives.tsx. *@
@* A coloured circle with the person's initials. Decorative: the name is always
   written beside it. The colour is a hash of the person's id, so the same
   person always has the same colour. *@
<span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center rounded-full font-semibold text-white"
      style="@($"width: {Size}px; height: {Size}px; background: {AvatarStyle.ColourFor(Seed ?? Name)}; font-size: {AvatarStyle.FontSize(Size)}px")">@AvatarStyle.InitialsOf(Name)</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>What the colour is hashed from (the person's id); the name when not given.</summary>
    [Parameter] public string? Seed { get; set; }

    [Parameter] public int Size { get; set; } = 36;
}
