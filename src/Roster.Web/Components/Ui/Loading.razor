@* The loading state a page shows while its data comes in, instead of
   appearing to hang. *@
<div class="flex min-h-[60vh] items-center justify-center" role="status">
    <div class="flex items-center gap-3 text-[var(--brand-navy)]/60">
        <span aria-hidden="true" class="inline-block h-5 w-5 animate-spin rounded-full border-2 border-[var(--brand-navy)]/30 border-t-[var(--brand-navy)]"></span>
        <span class="text-sm">Loading…</span>
    </div>
</div>
