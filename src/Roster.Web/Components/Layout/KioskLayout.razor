@inherits LayoutComponentBase
@inject RosterJs Js
@* The kiosk pages' layout: no menu, no sign-in box, the screen's own design.
   The Floor Display's stylesheet (css/kiosk/floor.css, the TypeScript app's
   floor.module.css) and the Load Planner's (css/kiosk/load.css, load.module.css)
   are loaded here only. *@
<HeadContent>
    <link rel="stylesheet" href="@Assets["css/kiosk/floor.css"]" />
    <link rel="stylesheet" href="@Assets["css/kiosk/load.css"]" />
</HeadContent>
@Body
<PortalOutlet />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Js.ReadyAsync();
    }
}
