@* Port of src/app/(app)/admin/rules/labour/LoadStartPanel.tsx.
   The Load Running start/finish model, as a HARD planning rule. Load size
   decides how early the crew starts; customers just after open decide how late
   load may still run on the floor; a minimum-window guarantee reconciles the
   two. The thresholds are the tunable part - the times themselves are the
   model. Every generated day applies this (night-fill stores excepted).
   Saved from the page's save bar with SaveLoadStartRulesAsync, which checks the
   thresholds and says which one is wrong. *@
@using Roster.Engine.Planning.Stage1
@inject ILabourRulesService Service

<SettingsSection Id="load-start">
    <Title>Load Running start</Title>
    <Purpose>How early the crew starts and when the load must be finished, from the day's load hours and morning customers. A hard rule on every generated day.</Purpose>
    <Aside>
        <label class="flex items-center gap-2 text-sm font-semibold text-[var(--ui-ink)]">
            <input type="checkbox" checked="@V.Enabled" @onchange="e => Patch(f => f with { Enabled = e.Value is true })" class="h-4 w-4 accent-[var(--ui-ink)]" />
            Rule enabled
        </label>
    </Aside>
    <ChildContent>
        <SaveSlot Id="load-start" Changes="Changes" Save="SaveAsync" Discard="Discard" />
        <div class="grid gap-x-4 gap-y-3 sm:grid-cols-3 xl:grid-cols-5">
            @Field(V.SmallLoadMaxHours, "07:00 start - up to", "h of load", (f, v) => f with { SmallLoadMaxHours = v })
            @Field(V.LargeLoadMinHours, "06:00 start - from", "h of load", (f, v) => f with { LargeLoadMinHours = v })
            @Field(V.QuietCustomersMax, "10:00 finish - up to", "customers", (f, v) => f with { QuietCustomersMax = v })
            @Field(V.BusyCustomersMax, "09:30 finish - up to", "customers", (f, v) => f with { BusyCustomersMax = v })
            @Field(V.CustomerWindowMin, "Customer sample", "min after open", (f, v) => f with { CustomerWindowMin = v })
        </div>
        @if (_error is not null)
        {
            <div class="mt-3">
                <FormMessage Tone="FormMessageTone.Error">@_error</FormMessage>
            </div>
        }

        @* A worked ladder off the values as typed, so a change is understood before
           it is saved - same idea as the Till Preview's bracket table. *@
        <div class="mt-4 overflow-x-auto rounded-xl border border-[var(--ui-line)]">
            <table class="@Ui.Table.Element">
                <thead class="@Ui.Table.Head">
                    <tr>
                        <th class="@Ui.Table.Th">LR hours \ morning customers</th>
                        @foreach (var c in SampleCustomers)
                        {
                            <th class="@($"{Ui.Table.Th} text-right")">@(c is { } n ? Js.NumberToString(n) : "No POS data")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in SampleLoads)
                    {
                        <tr class="@Ui.Table.Row">
                            <td class="px-3 py-1.5 font-medium tabular-nums">@Js.ToFixed(h, 1)h</td>
                            @foreach (var c in SampleCustomers)
                            {
                                var r = LoadStart.RecommendLoadWindow(h, c, RuleDraft);
                                <td class="px-3 py-1.5 text-right tabular-nums">@(Valid ? $"{Fmt(r.Start)} – {Fmt(r.Finish)}" : "-")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="mt-2 text-xs text-[var(--ui-muted)]">
            The grid previews the window for the values as typed, before saving. Changes apply from the
            next Generate - already-held plans keep the windows they were built with until regenerated.
        </p>

        <details class="mt-4 rounded-xl bg-[var(--ui-canvas)] px-4 py-3 text-xs text-[var(--ui-muted)]">
            <summary class="cursor-pointer text-sm font-semibold text-[var(--ui-ink)]">How the rule works</summary>
            <p class="mt-2">
                The day's Load Running hours decide how early the crew starts: at or below
                @Shown(N.SmallLoadMaxHours)h starts at 07:00, at or above
                @Shown(N.LargeLoadMinHours)h at 06:00, and anything
                <strong>between the two starts at 06:30</strong> - the middle band has no input of its own
                because the two boundaries define all three. Customers decide the finish (10:00 / 09:30 /
                09:00). Stores above the busy threshold keep at least 3 hours before their deadline, everyone
                else at least 2.5; no store starts later than 07:00. Night-fill stores are exempt and keep
                their evening window.
            </p>
            <p class="mt-2">
                <strong>This rule owns the load's window.</strong> While it is on it REPLACES whatever
                Load Running window is configured in the day-of-week grid above, and it overrides any anchor
                time set for Load Running on <strong>Process → Planning Order</strong> - that page decides
                only the order the hours fill inside this window, not when the window is. Switch this off
                and the day-of-week windows apply again.
            </p>
            <p class="mt-2">
                <strong>The customer figure:</strong> for the weekday being planned, the sum of MCO + SCO
                customers in the first @Shown(N.CustomerWindowMin)
                minutes after trading open, averaged over every usable date in the four-week POS sample -
                public holidays and zero-trade dates excluded. A store opening 08:30 with a 60-minute
                sample is measured on its 08:30, 08:45, 09:00 and 09:15 blocks. Widening the sample raises
                the measured figure, so the two customer thresholds should be retuned with it. A store with
                no POS data yet follows the load-size half alone, with the relaxed 10:00 finish.
            </p>
        </details>
    </ChildContent>
</SettingsSection>

@code {
    /// <summary>The form as typed: the switch and five threshold boxes.</summary>
    private sealed record Fields(bool Enabled, string SmallLoadMaxHours, string LargeLoadMinHours, string QuietCustomersMax, string BusyCustomersMax, string CustomerWindowMin);

    private sealed record Numbers(double SmallLoadMaxHours, double LargeLoadMinHours, double QuietCustomersMax, double BusyCustomersMax, double CustomerWindowMin)
    {
        public IEnumerable<double> All => [SmallLoadMaxHours, LargeLoadMinHours, QuietCustomersMax, BusyCustomersMax, CustomerWindowMin];
    }

    private static readonly double[] SampleLoads = [10, 13.5, 18];
    private static readonly double?[] SampleCustomers = [60, 105, 150, null];

    private FormDraft<Fields> _draft = new(new Fields(true, "", "", "", "", ""));
    private bool _started;
    private string? _error;

    [Parameter, EditorRequired] public LoadStartRules Rules { get; set; } = LoadStart.DefaultRules;

    /// <summary>After a save: the page reads the rule again.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private Fields V => _draft.Value;

    private Numbers N => new(Js.Number(V.SmallLoadMaxHours), Js.Number(V.LargeLoadMinHours), Js.Number(V.QuietCustomersMax), Js.Number(V.BusyCustomersMax), Js.Number(V.CustomerWindowMin));

    private bool Valid
    {
        get
        {
            var n = N;
            return n.All.All(x => double.IsFinite(x) && x > 0) && n.SmallLoadMaxHours < n.LargeLoadMinHours && n.QuietCustomersMax < n.BusyCustomersMax;
        }
    }

    // The clock times are on the Rostering rules page (R15); the preview keeps the saved ones.
    private LoadStartRules RuleDraft
    {
        get
        {
            var n = N;
            return Rules with
            {
                Enabled = V.Enabled,
                SmallLoadMaxHours = n.SmallLoadMaxHours,
                LargeLoadMinHours = n.LargeLoadMinHours,
                QuietCustomersMax = n.QuietCustomersMax,
                BusyCustomersMax = n.BusyCustomersMax,
                CustomerWindowMin = n.CustomerWindowMin,
            };
        }
    }

    private int Changes
    {
        get
        {
            var (v, b) = (_draft.Value, _draft.Base);
            var n = v.Enabled != b.Enabled ? 1 : 0;
            foreach (var (now, was) in new[] { (v.SmallLoadMaxHours, b.SmallLoadMaxHours), (v.LargeLoadMinHours, b.LargeLoadMinHours),
                         (v.QuietCustomersMax, b.QuietCustomersMax), (v.BusyCustomersMax, b.BusyCustomersMax), (v.CustomerWindowMin, b.CustomerWindowMin) })
                if (Js.Trim(now) == "" || Js.Number(now) != Js.Number(was)) n++;
            return n;
        }
    }

    private static string Fmt(double m) => $"{Js.PadStart(Js.NumberToString(Math.Floor(m / 60)), 2, '0')}:{Js.PadStart(Js.NumberToString(m % 60), 2, '0')}";

    private static string Shown(double n) => double.IsFinite(n) ? Js.NumberToString(n) : "-";

    protected override void OnParametersSet()
    {
        var saved = new Fields(Rules.Enabled, Js.NumberToString(Rules.SmallLoadMaxHours), Js.NumberToString(Rules.LargeLoadMinHours),
            Js.NumberToString(Rules.QuietCustomersMax), Js.NumberToString(Rules.BusyCustomersMax), Js.NumberToString(Rules.CustomerWindowMin));
        if (!_started)
        {
            _draft = new FormDraft<Fields>(saved);
            _started = true;
        }
        else _draft.Sync(saved);
    }

    private void Patch(Func<Fields, Fields> change)
    {
        _draft.Set(change);
        _error = null;
    }

    private RenderFragment Field(string value, string label, string unit, Func<Fields, string, Fields> with) =>
        @<label class="min-w-0">
            <span class="@Ui.FieldLabelClass">@label</span>
            <span class="flex items-center gap-2">
                <input type="number" step="1" min="1" value="@value" @oninput="e => Patch(f => with(f, e.Value?.ToString() ?? string.Empty))" class="@($"w-20 {Ui.CompactField}")" />
                <span class="text-xs text-[var(--ui-muted)]">@unit</span>
            </span>
        </label>;

    private async Task<bool> SaveAsync()
    {
        var sent = _draft.Value;
        var r = RuleDraft;
        var res = await Service.SaveLoadStartRulesAsync(new LoadStartInput(r.Enabled, r.SmallLoadMaxHours, r.LargeLoadMinHours, r.QuietCustomersMax, r.BusyCustomersMax, r.CustomerWindowMin));
        if (!res.Ok)
        {
            _error = $"Error: {res.Error}";
            StateHasChanged();
            return false;
        }
        _error = null;
        _draft.Commit(sent);
        await OnSaved.InvokeAsync();
        StateHasChanged();
        return true;
    }

    private void Discard()
    {
        _draft.Discard();
        _error = null;
    }
}
