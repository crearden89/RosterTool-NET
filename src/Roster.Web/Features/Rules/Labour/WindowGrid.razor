@* Port of WindowGrid in src/app/(app)/admin/rules/labour/LabourRulesClient.tsx.
   The windows as one week grid: each group a row, each day a column, each
   window a chip. A chip opens its editor under the grid (UpdateWindowAsync,
   DeleteWindowAsync); "Add a window" adds the same window to the chosen days
   (AddWindowAsync); "Clear all" empties a group (ClearWindowsAsync). Each acts
   at once, as the lists it replaces did. *@
@inject ILabourRulesService Service
@inject RosterJs Browser

<SettingsSection Id="windows">
    <Title>Windows by group</Title>
    <Purpose>When each labour group may be worked, day by day. A quota (in hours) fills that window first; the rest of the group's hours go to its other windows.</Purpose>
    <Aside>
        <button type="button" @onclick="ToggleAdding" aria-expanded="@(_adding ? "true" : "false")" aria-controls="add-window"
                class="@Ui.ButtonClass(ButtonKind.Secondary, ButtonSize.Sm)">
            <Icon Name="IconName.Plus" Class="h-3.5 w-3.5" /> Add a window
        </button>
    </Aside>
    <ChildContent>
        @if (_adding)
        {
            <WindowAdder Groups="Groups" OnDone="() => _adding = false" OnChanged="OnChanged" />
        }
        <div class="overflow-x-auto rounded-xl border border-[var(--ui-line)]">
            <table class="@($"{Ui.Table.Element} min-w-[760px]")">
                <thead class="@Ui.Table.Head">
                    <tr>
                        <th class="@Ui.Table.Th">Group</th>
                        @foreach (var d in Period.DayLabels)
                        {
                            <th class="px-1.5 py-2.5">@d</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Groups)
                    {
                        var group = g;
                        var any = Rules.Any(r => r.LabourGroup == group.Key);
                        <tr @key="group.Key" class="@($"{Ui.Table.Row} align-top")">
                            <th scope="row" class="py-2 pr-1.5 pl-3 text-left text-[13px] font-semibold whitespace-nowrap">
                                <span class="flex items-center gap-2">
                                    <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-sm" style="background: @group.Color"></span>
                                    @group.Label
                                </span>
                                @if (any)
                                {
                                    <button type="button" @onclick="() => ClearGroupAsync(group)" disabled="@_pending"
                                            class="@($"mt-1 ml-[18px] rounded-sm text-[11px] font-medium text-[var(--ui-bad)] hover:underline disabled:opacity-50 {Ui.FocusRing}")">
                                        Clear all
                                    </button>
                                }
                            </th>
                            @for (var i = 0; i < Period.DayLabels.Count; i++)
                            {
                                var day = Period.DayLabels[i];
                                var ws = Cell(group.Key, i);
                                <td class="px-1.5 py-2">
                                    @if (ws.Count == 0)
                                    {
                                        <span class="text-xs text-[var(--ui-muted)]">-</span>
                                    }
                                    else
                                    {
                                        <span class="flex flex-col gap-1">
                                            @foreach (var w in ws)
                                            {
                                                var window = w;
                                                var on = _editing == window.Id;
                                                <button @key="window.Id" type="button" aria-pressed="@(on ? "true" : "false")"
                                                        aria-label="@($"{group.Label}, {day} {window.WindowStart} to {window.WindowEnd}{(window.WindowHours is { } h ? $", {Js.NumberToString(h)} hours first" : "")}: change or delete")"
                                                        @onclick="() => Pick(window.Id, on)"
                                                        class="@Ui.Cx("rounded-lg px-1.5 py-0.5 text-left text-[11px] leading-tight font-medium whitespace-nowrap", Ui.FocusRing, on ? "bg-[var(--ui-ink)] text-white" : "bg-[var(--ui-lavender)] text-[var(--ui-ink)] hover:bg-[var(--ui-lavender-strong)]")">
                                                    @window.WindowStart–@window.WindowEnd
                                                    @if (window.WindowHours is { } hours)
                                                    {
                                                        <span class="@Ui.Cx("block text-[10px]", on ? "text-white/80" : "text-[var(--ui-muted)]")">@Js.NumberToString(hours) h first</span>
                                                    }
                                                </button>
                                            }
                                        </span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (EditRule is { } rule)
        {
            <WindowEditor @key="rule.Id" Rule="rule" Group="Groups.FirstOrDefault(g => g.Key == rule.LabourGroup)"
                          OnClose="() => _editing = null" OnChanged="OnChanged" />
        }
        else
        {
            <p class="mt-2 text-xs text-[var(--ui-muted)]">Click a window to change or delete it.</p>
        }
        @if (_error is not null)
        {
            <div class="mt-2">
                <FormMessage Tone="FormMessageTone.Error">@_error</FormMessage>
            </div>
        }
    </ChildContent>
</SettingsSection>

@code {
    private Guid? _editing;
    private bool _adding;
    private bool _pending;
    private string? _error;

    [Parameter, EditorRequired] public IReadOnlyList<LabourWindowRow> Rules { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<WindowGroupChip> Groups { get; set; } = [];

    /// <summary>After a change: the page reads the windows again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private LabourWindowRow? EditRule => _editing is { } id ? Rules.FirstOrDefault(r => r.Id == id) : null;

    private List<LabourWindowRow> Cell(string group, int day) =>
        Js.Sorted(Rules.Where(r => r.LabourGroup == group && r.DayOfWeek == day), (a, b) => Js.LocaleCompare(a.WindowStart, b.WindowStart));

    private void ToggleAdding()
    {
        _adding = !_adding;
        _editing = null;
    }

    private void Pick(Guid id, bool on)
    {
        _editing = on ? null : id;
        _adding = false;
        _error = null;
    }

    private async Task ClearGroupAsync(WindowGroupChip g)
    {
        if (!await Browser.ConfirmAsync($"Delete every {g.Label} window, on every day?")) return;
        _error = null;
        _pending = true;
        try
        {
            var res = await Service.ClearWindowsAsync(g.Key);
            if (!res.Ok) _error = res.Error ?? "Could not clear the windows.";
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _pending = false;
        }
    }
}
