@* Port of src/app/error.tsx, for an error the server could not show inside the page. *@
@page "/Error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout BareLayout
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>
<AppError Reference="@_requestId" RetryHref="" />

@code {
    private string? _requestId;

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    protected override void OnInitialized() => _requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
