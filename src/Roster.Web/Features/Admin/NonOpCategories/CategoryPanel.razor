@* Port of CategoryPanel in src/app/(app)/admin/non-op-categories/NonOpCategoriesClient.tsx. *@
@inject INonOpCategoriesService Service
@inject RosterJs RosterJs

<LeaveGuard Id="@($"category:{Category.Id}")" Dirty="@((_renaming && _catName != Category.Name) || _editingId is not null || _adding)" />
<SettingsSection Id="@($"cat-{Category.Id}")" Flush="true">
    <Title>
        @Category.Name
        <span class="ml-2 text-xs font-normal text-[var(--ui-muted)]">@($"{Subs.Count} sub-categor{(Subs.Count == 1 ? "y" : "ies")}")</span>
    </Title>
    <Aside>
        @if (!_renaming)
        {
            <button type="button" class="@SmallBtn" @onclick="() => _renaming = true">Rename</button>
        }
        @* Always clickable: deleting takes the category's sub-categories with it, so the
           confirm says so, and the server refuses outright if any recorded entries
           depend on them. *@
        <button type="button" class="@DangerBtn" disabled="@_pending" title="Delete this category and its sub-categories" @onclick="DeleteCategoryAsync">Delete</button>
    </Aside>
    <ChildContent>
        @if (_renaming)
        {
            <div class="flex flex-wrap items-center gap-2 px-5 pb-4 sm:px-6">
                <input aria-label="Category name" @bind="_catName" @bind:event="oninput" class="@Ui.CompactField" />
                <button type="button" class="@Ui.ButtonClass(ButtonKind.Primary, ButtonSize.Sm)" disabled="@_pending"
                        @onclick="@(() => RunAsync(() => AsDelete(Service.RenameCategoryAsync(Category.Id, _catName)), "Category renamed.", null, () => _renaming = false))">Save name</button>
                <button type="button" class="@Ui.ButtonClass(ButtonKind.Quiet, ButtonSize.Sm)" @onclick="CancelRename">Cancel</button>
            </div>
        }
        <div class="overflow-x-auto border-t border-[var(--ui-line)]">
            <table class="@Ui.Table.Element">
                <thead class="@Ui.Table.Head">
                    <tr>
                        <th class="@($"{Ui.Table.Th} pl-5 sm:pl-6")">Sub-category</th>
                        <th class="@($"{Ui.Table.Th} w-28 text-right")">Default</th>
                        <th class="@($"{Ui.Table.Th} w-28 text-right")">Maximum</th>
                        <th class="@Ui.Table.Th">Approval / note</th>
                        <th class="@($"{Ui.Table.Th} w-32")">Days</th>
                        <th class="@($"{Ui.Table.Th} w-40")"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Subs.Count == 0 && !_adding)
                    {
                        <tr><td colspan="6" class="@Ui.Table.Empty">No sub-categories yet.</td></tr>
                    }
                    @foreach (var s in Subs)
                    {
                        if (_editingId == s.Id)
                        {
                            <SubRowForm @key="s.Id" Initial="s" Pending="_pending" OnCancel="() => _editingId = null"
                                        OnSave="@(vals => RunAsync(() => AsDelete(Service.UpdateSubcategoryAsync(s.Id, vals)), "Sub-category saved.", null, () => _editingId = null))" />
                        }
                        else
                        {
                            <tr @key="s.Id" class="@($"{Ui.Table.Row} align-middle")">
                                <td class="py-2 pr-3 pl-5 font-semibold sm:pl-6">@s.Name</td>
                                <td class="px-3 py-2 text-right">@Minutes(s.DefaultMinutes)</td>
                                <td class="px-3 py-2 text-right">@Minutes(s.MaxMinutes)</td>
                                <td class="px-3 py-2 text-[var(--ui-muted)]">
                                    @if (s.Note is not null) { @s.Note } else { <span class="text-[var(--ui-faint)]">—</span> }
                                </td>
                                <td class="px-3 py-2 text-xs text-[var(--ui-muted)]">@NonOpRules.DaysLabel(s.DaysAllowed)</td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex justify-end gap-2">
                                        <button type="button" class="@SmallBtn" disabled="@_pending" @onclick="() => _editingId = s.Id">Edit</button>
                                        <button type="button" class="@DangerBtn" disabled="@_pending" @onclick="() => DeleteSubAsync(s)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (_adding)
                    {
                        <SubRowForm Pending="_pending" OnCancel="() => _adding = false"
                                    OnSave="@(vals => RunAsync(() => AsDelete(Service.AddSubcategoryAsync(Category.Id, vals)), "Sub-category added.", null, () => _adding = false))" />
                    }
                </tbody>
            </table>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-[var(--ui-line)] px-5 py-3 sm:px-6">
            @if (!_adding)
            {
                <button type="button" class="@Ui.ButtonClass(ButtonKind.Secondary, ButtonSize.Sm)" @onclick="() => _adding = true">
                    <Icon Name="IconName.Plus" Class="h-3.5 w-3.5" aria-hidden="true" /> Add sub-category
                </button>
            }
            @if (_msg is not null)
            {
                <FormMessage Tone="@(_msg.StartsWith("Error") ? FormMessageTone.Error : FormMessageTone.Ok)">@_msg</FormMessage>
            }
            @* Refused because real entries depend on it: offer the way through rather
               than a dead end, but make the cost explicit. *@
            @if (_blocked is { } b)
            {
                <button type="button" disabled="@_pending" @onclick="DeleteAnywayAsync"
                        class="@Ui.Cx("inline-flex items-center rounded-xl bg-[var(--ui-bad)] px-3 py-1.5 text-xs font-semibold text-white hover:brightness-110 disabled:opacity-50", Ui.FocusRing)">
                    @($"Delete anyway — removes {b.Count} entr{(b.Count == 1 ? "y" : "ies")}")
                </button>
            }
        </div>
    </ChildContent>
</SettingsSection>

@code {
    private static readonly string SmallBtn = Ui.ButtonClass(ButtonKind.Secondary, ButtonSize.Sm);
    private static readonly string DangerBtn = Ui.ButtonClass(ButtonKind.Danger, ButtonSize.Sm);

    [Parameter, EditorRequired] public NonOpCategoryRow Category { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<NonOpSubRow> Subs { get; set; } = [];
    [Parameter, EditorRequired] public EventCallback Reload { get; set; }

    private bool _pending, _renaming, _adding;
    private string _catName = "";
    private Guid? _editingId;
    private bool _nameSet;
    // Feedback belongs NEXT TO the button that was pressed - a message at the top of
    // a long page reads as "nothing happened".
    private string? _msg;
    // A refused delete remembers what to retry, so the escalation button knows which
    // row to force and how many entries it will take with it.
    private (bool IsCategory, Guid Id, string Label, int Count)? _blocked;

    protected override void OnParametersSet()
    {
        if (_nameSet) return;
        _catName = Category.Name;
        _nameSet = true;
    }

    private static RenderFragment Minutes(int? m) => __builder =>
    {
        if (m is { } v) { @($"{v}m") } else { <span class="text-[var(--ui-faint)]">—</span> }
    };

    private static async Task<DeleteResult> AsDelete(Task<AdminResult> action)
    {
        var r = await action;
        return new DeleteResult(r.Ok, r.Error);
    }

    private void CancelRename()
    {
        _catName = Category.Name;
        _renaming = false;
    }

    private async Task RunAsync(Func<Task<DeleteResult>> fn, string? okMsg, Action<int>? onBlocked = null, Action? onOk = null)
    {
        _pending = true;
        var res = await fn();
        _msg = res.Ok ? okMsg : $"Error: {res.Error}";
        if (!res.Ok && res.BlockedBy is { } n && n != 0 && onBlocked is not null) onBlocked(n);
        if (res.Ok)
        {
            _blocked = null;
            onOk?.Invoke();
            await Reload.InvokeAsync();
        }
        _pending = false;
    }

    private async Task DeleteCategoryAsync()
    {
        var warn = Subs.Count > 0
            ? $"Delete the {Category.Name} category and its {Subs.Count} sub-categor{(Subs.Count == 1 ? "y" : "ies")}?"
            : $"Delete the {Category.Name} category?";
        if (!await RosterJs.ConfirmAsync(warn)) return;
        _blocked = null;
        await RunAsync(() => Service.DeleteCategoryAsync(Category.Id), "Category deleted.",
            count => _blocked = (true, Category.Id, Category.Name, count));
    }

    private async Task DeleteSubAsync(NonOpSubRow s)
    {
        if (!await RosterJs.ConfirmAsync($"Delete \"{s.Name}\"?")) return;
        _blocked = null;
        await RunAsync(() => Service.DeleteSubcategoryAsync(s.Id), "Sub-category deleted.",
            count => _blocked = (false, s.Id, s.Name, count));
    }

    private async Task DeleteAnywayAsync()
    {
        if (_blocked is not { } b) return;
        var message =
            $"Permanently delete \"{b.Label}\" AND the {b.Count} recorded Non-Op entr{(b.Count == 1 ? "y" : "ies")} using it?\n\n" +
            "Those hours disappear from every store's history. This cannot be undone.";
        if (!await RosterJs.ConfirmAsync(message)) return;
        await RunAsync(
            () => b.IsCategory ? Service.DeleteCategoryAsync(b.Id, force: true) : Service.DeleteSubcategoryAsync(b.Id, force: true),
            "Deleted, along with its entries.");
    }
}
