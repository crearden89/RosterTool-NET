@page "/admin/kiosk-links"
@* Port of src/app/(app)/admin/kiosk-links/page.tsx and KioskLinksClient.tsx. *@
@inject IKioskLinksService Service
@inject RosterJs RosterJs
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<div>
    <PageHeader Title="Kiosk Links" />
    <div>
        <div class="overflow-x-auto rounded-xl border border-[var(--brand-border)] bg-white">
            <table class="w-full text-sm">
                <thead class="ui-thead">
                    <tr>
                        <th class="px-3 py-2 font-medium">Store</th>
                        <th class="px-3 py-2 font-medium">Floor Display</th>
                        <th class="px-3 py-2 font-medium">Load Planner</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _stores)
                    {
                        <tr @key="s.Id" class="border-t border-[var(--brand-border)]">
                            <td class="whitespace-nowrap px-3 py-2 font-semibold text-[var(--brand-navy)]">
                                @s.Code <span class="font-normal text-[var(--brand-navy)]/60">@s.Name</span>
                            </td>
                            <td class="px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <a href="@s.FloorPath" target="_blank" rel="noopener noreferrer" class="text-[var(--brand-navy)] underline">Open</a>
                                    <button class="@LinkBtn" @onclick="() => CopyAsync(s.FloorPath, Key('f', s))">@(_copied == Key('f', s) ? "Copied ✓" : "Copy link")</button>
                                </div>
                            </td>
                            <td class="px-3 py-2">
                                <div class="flex items-center gap-2">
                                    <a href="@s.LoadPath" target="_blank" rel="noopener noreferrer" class="text-[var(--brand-navy)] underline">Open</a>
                                    <button class="@LinkBtn" @onclick="() => CopyAsync(s.LoadPath, Key('l', s))">@(_copied == Key('l', s) ? "Copied ✓" : "Copy link")</button>
                                </div>
                            </td>
                            <td class="px-3 py-2 text-right">
                                <button @onclick="() => RotateAsync(s)" disabled="@_pending"
                                        class="rounded-lg border border-[var(--brand-red)] px-3 py-1.5 text-xs font-semibold text-[var(--brand-red)] hover:bg-[var(--brand-red-tint)] disabled:opacity-60">
                                    Rotate
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_msg is not null)
        {
            <p class="@($"mt-3 text-sm {(_msg.StartsWith("Error") ? "text-[var(--brand-red)]" : "text-green-700")}")">@_msg</p>
        }
    </div>
</div>

@code {
    private const string LinkBtn =
        "rounded-lg border border-[var(--brand-border)] px-3 py-1.5 text-xs font-semibold text-[var(--brand-navy)] hover:bg-[var(--brand-surface)]";

    private IReadOnlyList<KioskLinkRow> _stores = [];
    private bool _pending;
    private string? _msg;
    private string? _copied;
    private CancellationTokenSource? _copiedTimer;

    private static string Key(char kind, KioskLinkRow s) => $"{kind}-{s.Id}";

    protected override async Task OnInitializedAsync() => _stores = await Service.LoadAsync();

    // Absolute URLs are built from the address the browser has open, so the same
    // code works on any deployment domain.
    private async Task CopyAsync(string path, string key)
    {
        var origin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
        await AdminClipboard.WriteAsync(JS, $"{origin}{path}");
        _copied = key;
        _copiedTimer?.Cancel();
        var timer = _copiedTimer = new CancellationTokenSource();
        _ = Task.Delay(1500, timer.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() =>
            {
                if (_copied == key) _copied = null;
                StateHasChanged();
            });
        }, TaskScheduler.Default);
    }

    private async Task RotateAsync(KioskLinkRow store)
    {
        if (!await RosterJs.ConfirmAsync($"Rotate {store.Code}'s kiosk links? The links currently pinned on its tablet stop working immediately.")) return;
        _pending = true;
        var res = await Service.RotateKioskTokenAsync(store.Id);
        _msg = res.Ok ? $"{store.Code} links rotated - re-pin the tablet." : $"Error: {res.Error}";
        if (res.Ok) _stores = await Service.LoadAsync();
        _pending = false;
    }

    public void Dispose() => _copiedTimer?.Cancel();
}
