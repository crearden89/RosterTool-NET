@* Port of src/app/load/[token]/LoadIcons.tsx: the Load Planner's small line icons,
   drawn in the text colour. *@

@switch (Name)
{
    case LoadIcons.Pin:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M7 2.5h6l-1 5 3 3H5l3-3-1-5zM10 10.5V18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
        break;
    case LoadIcons.Caret:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M5.5 8l4.5 4.5L14.5 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case LoadIcons.Tick:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case LoadIcons.Back:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M12.5 4.5L7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case LoadIcons.Minus:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M4 10h12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        break;
    case LoadIcons.Plus:
        <svg viewBox="0 0 20 20" class="@Class" aria-hidden="true">
            <path d="M4 10h12M10 4v12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        break;
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}
