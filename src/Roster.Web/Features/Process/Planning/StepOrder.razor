@* Port of src/app/(app)/admin/process/planning/StepOrder.tsx.
   The seven steps of the solve, in the order the engine runs them.
   Steps 1-6 move: each group fills around what the groups before it already
   claimed, so first place gets the best of the day. Step 7 does not - Checkout
   is not placed but imposed, and the shifts are cut around it.
   Saved from the page's save bar (SaveStepOrderAsync, which checks every step
   is there once). *@
@using Roster.Engine.Planning.Plan
@inject IPlanningOrderService Service

<SettingsSection Id="steps">
    <Title>Step order</Title>
    <Purpose>The order the day's aisle work is laid down: each group fills around what the groups before it claimed, so first place gets the best of the day.</Purpose>
    <ChildContent>
        <SaveSlot Id="step-order" Changes="Changes" Save="SaveAsync" Discard="Discard" />
        <div class="mb-4 space-y-2 text-sm text-[var(--ui-muted)]">
            <p>
                The aisle work goes on the canvas first, one group at a time, each filling
                <em>around</em> what the groups before it already claimed — so first place gets the best
                of the day and everything after works with what is left. Least free work first is the
                shipped order: Admin's jobs have deadlines measured in single blocks, Cleaning has a
                whole evening. No group may exceed its benchmark hours.
            </p>
            <p>
                Only then are the registers dealt with, and they are not placed at all — the till engine
                fixes how many are open in every fifteen minutes and the shifts are cut so each one has a
                body. Where a block is short of tills, aisle work moves aside <em>within its own window</em>
                rather than a register going unmanned.
            </p>
        </div>

        <div class="rounded-xl border border-[var(--ui-line)]">
            @{ var steps = _draft.Value; }
            @for (var i = 0; i < steps.Count; i++)
            {
                var at = i;
                var g = steps[i];
                @Row(Placement.GroupLabel[g], Placement.StepNote[g], i + 1,
                    @<span class="flex shrink-0 gap-1">
                        <button type="button" @onclick="() => Move(at, -1)" disabled="@(at == 0)" aria-label="@($"Move {Placement.GroupLabel[g]} earlier")" class="@Arrow">
                            <Icon Name="IconName.ArrowUp" Class="h-3.5 w-3.5" />
                        </button>
                        <button type="button" @onclick="() => Move(at, 1)" disabled="@(at == steps.Count - 1)" aria-label="@($"Move {Placement.GroupLabel[g]} later")" class="@Arrow">
                            <Icon Name="IconName.ArrowDown" Class="h-3.5 w-3.5" />
                        </button>
                    </span>)
            }
            @Row(Placement.GroupLabel["non_op"], Placement.StepNote["non_op"], Placement.StepGroups.Count + 1,
                @<span class="shrink-0 self-center text-xs text-[var(--ui-muted)]">fixed</span>)
            @Row(Placement.GroupLabel["checkout"], Placement.StepNote["checkout"], Placement.StepGroups.Count + 2,
                @<span class="shrink-0 self-center text-xs text-[var(--ui-muted)]">always last</span>)
        </div>
        @if (_err is not null)
        {
            <div class="mt-3">
                <FormMessage Tone="FormMessageTone.Error">@_err</FormMessage>
            </div>
        }
    </ChildContent>
</SettingsSection>

@code {
    private const string Arrow = "rounded-lg border border-[var(--ui-control)] p-1 text-[var(--ui-ink)] hover:bg-[var(--ui-lavender)] disabled:opacity-30 " + Ui.FocusRing;

    private FormDraft<IReadOnlyList<string>> _draft = new([]);
    private bool _started;
    private string? _err;

    [Parameter, EditorRequired] public IReadOnlyList<string> Order { get; set; } = [];

    /// <summary>After a save: the page reads the configuration again.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private int Changes => string.Join(",", _draft.Value) == string.Join(",", _draft.Base) ? 0 : 1;

    protected override void OnParametersSet()
    {
        if (!_started)
        {
            _draft = new FormDraft<IReadOnlyList<string>>(Order);
            _started = true;
        }
        else _draft.Sync(Order);
    }

    private static RenderFragment Row(string label, string note, int n, RenderFragment controls) =>
        @<div class="flex items-start gap-3 border-b border-[var(--ui-line)] p-3 last:border-0">
            <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--ui-ink)] text-xs font-semibold text-white">@n</span>
            <div class="min-w-0 flex-1">
                <p class="font-semibold text-[var(--ui-ink)]">@label</p>
                <p class="mt-0.5 text-xs text-[var(--ui-muted)]">@note</p>
            </div>
            @controls
        </div>;

    private void Move(int i, int by)
    {
        var j = i + by;
        var steps = _draft.Value;
        if (j < 0 || j >= steps.Count) return;
        var next = steps.ToList();
        (next[i], next[j]) = (next[j], next[i]);
        _draft.Set(next);
        _err = null;
    }

    private async Task<bool> SaveAsync()
    {
        var sent = _draft.Value;
        var res = await Service.SaveStepOrderAsync(sent);
        if (!res.Ok)
        {
            _err = res.Error ?? "Could not save the order";
            StateHasChanged();
            return false;
        }
        _err = null;
        _draft.Commit(sent);
        await OnSaved.InvokeAsync();
        StateHasChanged();
        return true;
    }

    private void Discard()
    {
        _draft.Discard();
        _err = null;
    }
}
