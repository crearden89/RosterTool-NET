@* Port of src/app/(app)/admin/process/roster/OrderClient.tsx.
   The fortnight solve's phases, edited as one list and saved from the page's
   save bar (SaveAsync, which checks every step and day order). Reset to
   recommended still acts at once. *@
@inject IRosterOrderService Service
@inject RosterJs Browser

<SaveSlot Id="roster-order" Changes="Changes" Save="SaveAsync" Discard="DiscardAsync" />
<div class="rounded-2xl border border-[var(--ui-bad)]/30 bg-[var(--brand-red-tint)]/60 p-4 text-sm text-[var(--ui-ink)] sm:p-5">
    <p class="flex items-center gap-2 font-semibold text-[var(--ui-bad)]">
        <Icon Name="IconName.TriangleAlert" Class="h-4 w-4" /> Changes here can have legal implications.
    </p>
    <p class="mt-1">
        The order decides who is offered scarce shifts first. Every phase still obeys the hard
        rules (rest gaps, junior windows, safety floors, weekly caps), but a poorly-ordered
        sequence can leave shifts uncovered or concentrate hours in ways that breach award
        obligations. Review the warnings below before saving; changes apply from the next
        generate.
    </p>
</div>

<SettingsSection Id="phases">
    <Title>Phases in order</Title>
    <Purpose>Which phases the fortnight solve runs, and in what sequence - each one filling around what the phases before it committed.</Purpose>
    <Aside>
        <button type="button" @onclick="ResetAsync" disabled="@_busy" class="@Ui.ButtonClass(ButtonKind.Secondary, ButtonSize.Sm)">Reset to recommended</button>
    </Aside>
    <ChildContent>
        @{ var steps = _draft.Value; var warnings = RosterOrder.ValidateOrder(steps); }
        @if (warnings.Count > 0)
        {
            <div class="mb-4 rounded-xl bg-[var(--ui-amber-bg)] p-4 text-sm text-[var(--ui-ink)]">
                <p class="mb-1 font-semibold text-[var(--ui-amber-ink)]">Order warnings</p>
                <ul class="list-disc space-y-1 pl-5">
                    @foreach (var w in warnings)
                    {
                        <li>@w</li>
                    }
                </ul>
            </div>
        }

        <div class="space-y-2">
            @for (var i = 0; i < steps.Count; i++)
            {
                var at = i;
                var s = steps[i];
                var meta = RosterOrder.StepMetaFor(s.Type)!;
                <div @key="@($"{s.Type}-{i}-{_version}")" class="flex items-start gap-3 rounded-xl border border-[var(--ui-line)] bg-white p-3">
                    <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--ui-ink)] text-xs font-semibold text-white">@(i + 1)</span>
                    <div class="min-w-0 flex-1">
                        <p class="font-semibold text-[var(--ui-ink)]">@meta.Label</p>
                        <p class="text-xs text-[var(--ui-muted)]">@meta.Description</p>
                        @if (FillTypes.Contains(s.Type))
                        {
                            <DayOrderEditor Value="s.DayOrder" OnChange="d => SetDayOrder(at, d)" />
                        }
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                        <button type="button" @onclick="() => Move(at, -1)" disabled="@(at == 0)" aria-label="@($"Move {meta.Label} up")" class="@Arrow">
                            <Icon Name="IconName.ArrowUp" Class="h-3.5 w-3.5" />
                        </button>
                        <button type="button" @onclick="() => Move(at, 1)" disabled="@(at == steps.Count - 1)" aria-label="@($"Move {meta.Label} down")" class="@Arrow">
                            <Icon Name="IconName.ArrowDown" Class="h-3.5 w-3.5" />
                        </button>
                        <button type="button" @onclick="() => Remove(at)" aria-label="@($"Delete step {at + 1}, {meta.Label}")"
                                class="@($"rounded-lg border border-[var(--ui-control)] p-1 text-[var(--ui-bad)] hover:bg-[var(--brand-red-tint)] {Ui.FocusRing}")">
                            <Icon Name="IconName.X" Class="h-3.5 w-3.5" />
                        </button>
                    </div>
                </div>
            }
            @if (steps.Count == 0)
            {
                <p class="rounded-xl border border-[var(--ui-line)] bg-white p-4 text-sm text-[var(--ui-muted)]">
                    No steps - saving now restores the recommended default order.
                </p>
            }
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
            <select aria-label="Step to add" value="@_addType" @onchange="e => _addType = e.Value?.ToString() ?? _addType" class="@Ui.CompactField">
                @foreach (var m in RosterOrder.StepMeta)
                {
                    <option value="@m.Type">@m.Label</option>
                }
            </select>
            <button type="button" @onclick="Add" class="@Ui.ButtonClass(ButtonKind.Secondary, ButtonSize.Sm)">
                <Icon Name="IconName.Plus" Class="h-3.5 w-3.5" /> Add step
            </button>
        </div>
        @if (_err is not null)
        {
            <div class="mt-3">
                <FormMessage Tone="FormMessageTone.Error">@_err</FormMessage>
            </div>
        }
        @if (UsingDefault && Changes == 0)
        {
            <p class="mt-3 text-sm text-[var(--ui-muted)]">Currently using the recommended default order.</p>
        }
    </ChildContent>
</SettingsSection>

@code {
    private const string Arrow = "rounded-lg border border-[var(--ui-control)] p-1 text-[var(--ui-ink)] hover:bg-[var(--ui-lavender)] disabled:opacity-30 " + Ui.FocusRing;

    private static readonly HashSet<string> FillTypes =
        [OrderStepTypes.AllocateSm, OrderStepTypes.AllocateAsm, OrderStepTypes.AllocateDsm, OrderStepTypes.FillFloor];

    private FormDraft<IReadOnlyList<OrderStep>> _draft = new([]);
    private bool _started;
    private string _addType = OrderStepTypes.FillFloor;
    private string? _err;
    // Bumped when the list goes back to what is saved, so each day-order box shows
    // the saved order again rather than what was typed in it.
    private int _version;
    private bool _busy;

    /// <summary>The saved phases; empty when the default order is in use.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OrderStep> Saved { get; set; } = [];

    /// <summary>After a change is saved: the page reads the order again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool UsingDefault => Saved.Count == 0;

    private int Changes => SaveBar.CountChanged(_draft.Base, _draft.Value, s => s.Type, s => s.DayOrder);

    protected override void OnParametersSet()
    {
        if (!_started)
        {
            _draft = new FormDraft<IReadOnlyList<OrderStep>>(UsingDefault ? RosterOrder.DefaultOrder.ToList() : Saved);
            _started = true;
        }
        else _draft.Sync(UsingDefault ? RosterOrder.DefaultOrder.ToList() : Saved);
    }

    private void Patch(List<OrderStep> next) => _draft.Set(next);

    private void Move(int i, int delta)
    {
        var steps = _draft.Value;
        var j = i + delta;
        if (j < 0 || j >= steps.Count) return;
        var next = steps.ToList();
        (next[i], next[j]) = (next[j], next[i]);
        Patch(next);
    }

    private void Remove(int i) => Patch(_draft.Value.Where((_, k) => k != i).ToList());

    private void Add() =>
        Patch([.. _draft.Value, new OrderStep(_addType, FillTypes.Contains(_addType) ? RosterOrder.DefaultFloorDayOrder.ToList() : null)]);

    private void SetDayOrder(int i, IReadOnlyList<int> d) =>
        Patch(_draft.Value.Select((s, k) => k == i ? s with { DayOrder = d } : s).ToList());

    private async Task<bool> SaveAsync()
    {
        var sent = _draft.Value;
        var res = await Service.SaveAsync(sent);
        if (!res.Ok)
        {
            _err = res.Error ?? "Save failed.";
            StateHasChanged();
            return false;
        }
        _err = null;
        _draft.Commit(sent);
        await OnChanged.InvokeAsync();
        StateHasChanged();
        return true;
    }

    private Task DiscardAsync()
    {
        _draft.Discard();
        _err = null;
        _version++;
        return Task.CompletedTask;
    }

    private async Task ResetAsync()
    {
        if (!await Browser.ConfirmAsync("Go back to the recommended order? The saved order is replaced.")) return;
        _busy = true;
        try
        {
            var res = await Service.ResetAsync();
            if (!res.Ok) _err = res.Error ?? "Reset failed.";
            else
            {
                _err = null;
                var next = RosterOrder.DefaultOrder.ToList();
                _draft.Set(next);
                _draft.Commit(next);
                _version++;
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
