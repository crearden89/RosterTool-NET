@* Port of src/app/(app)/plan/roster/ContractsCard.tsx.
   ─── "Contracts this fortnight" on the Roster page ───────────────────────────
   Who the roster leaves under or above contract, as bars - in place of the
   long list of contract flags. The figures are the engine's own outcomes,
   held with the roster (lib/roster/contracts); they replace the contract
   flags, which say the same. Every other fortnight flag (run lengths, why a
   contract can't be met) is listed under them. A roster held before the
   figures were kept shows its flags as they are. *@
<Card Padded="false" Class="@Class">
    <div class="px-5 pt-5 sm:px-6">
        <SectionHeader>
            <Title>Contracts this fortnight</Title>
            <Aside>
                @if (Figures is { } f)
                {
                    <span class="flex flex-wrap gap-1.5">
                        @if (f.UnderHours > 0)
                        {
                            <Pill Tone="PillTone.Amber">@H2(f.UnderHours) h short</Pill>
                        }
                        @if (f.OverHours > 0)
                        {
                            <Pill Tone="PillTone.Red">@H2(f.OverHours) h over</Pill>
                        }
                    </span>
                }
                else
                {
                    @("The figures show once the roster is next built")
                }
            </Aside>
        </SectionHeader>
    </div>
    <div class="border-t border-[var(--ui-line)] px-5 py-4 sm:px-6">
        @if (Figures is { } fig)
        {
            @if (fig.People.Count == 0)
            {
                <p class="text-sm text-[var(--ui-muted)]">Everyone is within half an hour of their contract.</p>
            }
            else
            {
                <ul class="space-y-2.5">
                    @foreach (var p in fig.People.Take(Shown))
                    {
                        @Row(p)
                    }
                </ul>
                @if (fig.People.Count > Shown)
                {
                    <details class="mt-2.5">
                        <summary class="cursor-pointer text-xs font-semibold text-[var(--ui-violet)]">and @(fig.People.Count - Shown) more</summary>
                        <ul class="mt-2.5 space-y-2.5">
                            @foreach (var p in fig.People.Skip(Shown))
                            {
                                @Row(p)
                            }
                        </ul>
                    </details>
                }
            }
            @if (fig.Team is { Length: > 0 } team)
            {
                <p class="mt-3 text-xs text-[var(--ui-muted)]">@team</p>
            }
        }
        @if (Flags.Count > 0)
        {
            <ul class="@(Figures is not null ? "mt-3 space-y-1 border-t border-[var(--ui-line)] pt-3 text-xs text-[var(--ui-muted)]" : "space-y-1 text-sm text-[var(--ui-ink)]")">
                @foreach (var f in Flags)
                {
                    <li>@f</li>
                }
            </ul>
        }
        @if (Figures is null && Flags.Count == 0)
        {
            <p class="text-sm text-[var(--ui-muted)]">No fortnight checks.</p>
        }
    </div>
</Card>

@code {
    private const int Shown = 9;

    /// <summary>Null for a roster held before the figures were kept.</summary>
    [Parameter] public RosterContracts? Figures { get; set; }

    /// <summary>
    /// The fortnight flags to list: those the figures do not show (otherFortnightFlags), or
    /// every flag when there are no figures.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Flags { get; set; } = [];

    [Parameter] public string Class { get; set; } = "";

    private static string H2(double n) => Js.ToFixed(n, 2);

    private double Max => Figures is { People.Count: > 0 } f ? Math.Max(1, f.People.Max(p => p.Hours)) : 1;

    private RenderFragment Row(RosterContractGap p) => __builder =>
    {
        <li @key="p.EmployeeId" class="grid grid-cols-[minmax(0,8.5rem)_1fr_4.75rem] items-center gap-3 text-sm">
            <span class="truncate font-medium text-[var(--ui-ink)]" title="@p.Name">@p.Name</span>
            <span aria-hidden="true" class="block h-2.5 overflow-hidden rounded-full bg-[var(--ui-lavender)]">
                <span class="block h-full rounded-full"
                      style="@($"width:{Js.NumberToString(Math.Max(3, Math.Min(100, p.Hours / Max * 100)))}%;background:{(p.Over ? "var(--ui-bad)" : "#e3a12b")}")"></span>
            </span>
            <span class="@($"text-right font-semibold tabular-nums {(p.Over ? "text-[var(--ui-bad)]" : "text-[var(--ui-amber-ink)]")}")">
                <span class="sr-only">@(p.Over ? "above contract by " : "under contract by ")</span>@(p.Over ? "+" : "−")@H2(p.Hours) h
            </span>
        </li>
    };
}
