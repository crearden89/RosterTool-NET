@* Every page under Features/ needs someone signed in with access to the app,
   unless it says otherwise: a Super User page adds
   @attribute [Authorize(Policy = Policies.SuperUser)]; a kiosk page and the
   sign-in pages are @attribute [AllowAnonymous].
   The app's own namespaces are written global:: so a page area named like a
   namespace (Features/RosterPage) can never hide them. *@
@using System.Net.Http
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using global::Roster.Engine.Core
@using global::Roster.Data.Scope
@using global::Roster.Web
@using global::Roster.Web.Auth
@using global::Roster.Web.Components
@using global::Roster.Web.Components.Layout
@using global::Roster.Web.Components.Ui
@using global::Roster.Web.Kiosk
@attribute [Authorize]
