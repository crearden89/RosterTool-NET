@* Port of TargetsForm in src/app/(app)/admin/leave-liability/LeaveSettings.tsx. *@
@using global::Roster.Engine.Core
@inject ILeaveLiabilityService Service
@inject NavigationManager Navigation
<SaveSlot Id="leave-targets" Changes="Changes" Save="SaveAsync" Discard="Discard" />
<SettingsSection Id="leave-targets">
    <Title>Targets</Title>
    <Purpose>What every store&apos;s liability is measured against, and what counts as one FTE. Both apply across the network.</Purpose>
    <Aside><Pill Tone="PillTone.Soft">Every store</Pill></Aside>
    <ChildContent>
        <div class="flex flex-wrap gap-x-6 gap-y-4">
            <label class="block">
                <span class="@Ui.FieldLabelClass">Target annual leave hours per FTE</span>
                <span class="flex items-center gap-2">
                    <input type="number" step="0.01" value="@_draft.Value.T" @oninput="e => Edit(v => v with { T = e.Value?.ToString() ?? string.Empty })" class="@($"w-28 {Ui.FieldClass}")" />
                    <span class="text-sm text-[var(--ui-muted)]">h</span>
                </span>
            </label>
            <label class="block">
                <span class="@Ui.FieldLabelClass">FTE divisor (full-time fortnight)</span>
                <span class="flex items-center gap-2">
                    <input type="number" step="0.01" value="@_draft.Value.F" @oninput="e => Edit(v => v with { F = e.Value?.ToString() ?? string.Empty })" class="@($"w-28 {Ui.FieldClass}")" />
                    <span class="text-sm text-[var(--ui-muted)]">h</span>
                </span>
            </label>
        </div>
        @if (_msg is { } msg)
        {
            <div class="mt-3"><FormMessage Tone="msg.Tone">@msg.Text</FormMessage></div>
        }
    </ChildContent>
</SettingsSection>

@code {
    private FormDraft<TargetsDraft> _draft = new(new("", ""));
    private bool _started;
    private (FormMessageTone Tone, string Text)? _msg;

    [Parameter] public double Target { get; set; }
    [Parameter] public double FteDivisor { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private TargetsDraft Saved => new(Js.NumberToString(Target), Js.NumberToString(FteDivisor));

    protected override void OnParametersSet()
    {
        if (!_started)
        {
            _draft = new FormDraft<TargetsDraft>(Saved);
            _started = true;
        }
        else
        {
            _draft.Sync(Saved);
        }
    }

    private int Changes =>
        (LeaveSettingsShared.Differs(_draft.Value.T, _draft.Base.T) ? 1 : 0) + (LeaveSettingsShared.Differs(_draft.Value.F, _draft.Base.F) ? 1 : 0);

    private void Edit(Func<TargetsDraft, TargetsDraft> change)
    {
        _draft.Set(change);
        _msg = null;
    }

    private async Task<bool> SaveAsync()
    {
        var sent = _draft.Value;
        // The action's own check (both above zero) decides; its words are shown.
        var res = await Service.SaveLeaveSettingsAsync(Js.Number(sent.T), Js.Number(sent.F));
        if (res.RedirectTo is { } to)
        {
            Navigation.NavigateTo(to);
            return false;
        }
        if (!res.Ok)
        {
            _msg = (FormMessageTone.Error, $"Error: {res.Error}");
            StateHasChanged();
            return false;
        }
        _msg = (FormMessageTone.Ok, "Saved.");
        _draft.Commit(sent);
        await OnSaved.InvokeAsync();
        return true;
    }

    private void Discard()
    {
        _draft.Discard();
        _msg = null;
    }
}
