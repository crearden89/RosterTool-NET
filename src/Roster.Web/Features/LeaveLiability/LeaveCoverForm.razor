@* Port of CoverForm in src/app/(app)/admin/leave-liability/LeaveSettings.tsx. *@
@using global::Roster.Engine.Core
@inject ILeaveLiabilityService Service
<SaveSlot Id="leave-cover" Changes="@(LeaveSettingsShared.Differs(_draft.Value, _draft.Base) ? 1 : 0)" Save="SaveAsync" Discard="Discard" />
<SettingsSection Id="leave-cover">
    <Title>@($"Cover · {StoreName}")</Title>
    <Purpose>This store&apos;s own number, set by the Store Manager - a small store might only cover two at once where a larger one covers four.</Purpose>
    <Aside><Pill Tone="PillTone.Soft">This store</Pill></Aside>
    <ChildContent>
        <label class="block">
            <span class="@Ui.FieldLabelClass">Maximum people on leave at once</span>
            <span class="flex items-center gap-2">
                <input type="number" min="0" max="99" value="@_draft.Value" @oninput="e => Edit(e.Value?.ToString() ?? string.Empty)" class="@($"w-24 {Ui.FieldClass}")" />
                <span class="text-sm text-[var(--ui-muted)]">people</span>
            </span>
        </label>
        <p class="mt-3 max-w-3xl text-xs leading-relaxed text-[var(--ui-muted)]">
            A date becomes <strong class="text-[var(--ui-ink)]">unavailable</strong> on the Calendar and the Overview once this many people
            already hold approved annual leave on it, so nobody books over the top of the cover.
        </p>
        @if (_msg is { } msg)
        {
            <div class="mt-3"><FormMessage Tone="msg.Tone">@msg.Text</FormMessage></div>
        }
    </ChildContent>
</SettingsSection>

@code {
    private FormDraft<string> _draft = new("");
    private bool _started;
    private (FormMessageTone Tone, string Text)? _msg;

    [Parameter, EditorRequired] public Guid StoreId { get; set; }
    [Parameter] public string StoreName { get; set; } = "";
    [Parameter] public int Max { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    protected override void OnParametersSet()
    {
        if (!_started)
        {
            _draft = new FormDraft<string>(Max.ToString());
            _started = true;
        }
        else
        {
            _draft.Sync(Max.ToString());
        }
    }

    private void Edit(string value)
    {
        _draft.Set(value);
        _msg = null;
    }

    private async Task<bool> SaveAsync()
    {
        var sent = _draft.Value;
        // SaveMaxOnLeave checks the store may be edited and the 0-99 range.
        var res = await Service.SaveMaxOnLeaveAsync(StoreId, Js.Number(sent));
        if (!res.Ok)
        {
            _msg = (FormMessageTone.Error, $"Error: {res.Error}");
            StateHasChanged();
            return false;
        }
        _msg = (FormMessageTone.Ok, "Saved.");
        _draft.Commit(sent);
        await OnSaved.InvokeAsync();
        return true;
    }

    private void Discard()
    {
        _draft.Discard();
        _msg = null;
    }
}
