@* Port of FixedRosterSheet in src/app/(app)/setup/staff/FixedRosters.tsx: one
   person's fixed roster in a side sheet - the locked shifts as they stand and, for
   anyone who may edit, the cycle editor that was the Requests page's pattern
   dialog (1, 2 or 4 weekly templates, 24-hour times, the date Week 1 starts), with
   the same checks before saving. *@
@using System.Globalization
@inject ITeamService Team
@inject RosterJs Browser

<SideSheet TitleId="fixed-roster-title" OnClose="OnClose">
    <Eyebrow>Fixed roster</Eyebrow>
    <Title>
        <span class="flex items-center gap-3">
            <Avatar Name="@Employee.Name" Seed="@Employee.Id.ToString()" Size="36" />
            @Employee.Name
        </span>
    </Title>
    <Badges>
        @if (_has)
        {
            <Pill Tone="PillTone.Soft">@TeamRules.CycleLabel(_heldWeeks)</Pill>
            @if (_heldWeeks > 1)
            {
                <Pill Tone="PillTone.Soft">Week @(_now + 1) now</Pill>
            }
            @if (Over)
            {
                <Pill Tone="PillTone.Amber">Pays above contract</Pill>
            }
        }
        else
        {
            <Pill Tone="PillTone.Soft">No fixed roster</Pill>
        }
    </Badges>
    <Actions>
        <SheetIconButton Label="Close" OnClick="OnClose">
            <Icon Name="IconName.X" Class="h-4 w-4" />
        </SheetIconButton>
    </Actions>
    <Footer>
        @if (ReadOnly)
        {
            <button type="button" @onclick="OnClose" class="@($"ml-auto {Ui.ButtonClass(ButtonKind.Secondary)}")">Close</button>
        }
        else
        {
            @if (_has)
            {
                <button type="button" disabled="@_busy" @onclick="ClearAsync" class="@Ui.ButtonClass(ButtonKind.Danger)">Clear fixed roster</button>
            }
            else
            {
                <span></span>
            }
            <span class="flex gap-2">
                <button type="button" @onclick="OnClose" class="@Ui.ButtonClass(ButtonKind.Secondary)">Cancel</button>
                <button type="button" disabled="@_busy" @onclick="SaveAsync" class="@Ui.ButtonClass(ButtonKind.Accent)">@(_busy ? "Saving…" : "Save fixed roster")</button>
            </span>
        }
    </Footer>
    <ChildContent>
        <div class="space-y-4">
            <Card Class="!p-4">
                <SectionHeader Aside="@LockedAside">
                    <Title>Locked shifts</Title>
                </SectionHeader>
                @if (_has)
                {
                    <div class="space-y-3">
                        @for (var w = 0; w < _heldWeeks; w++)
                        {
                            var week = w;
                            <div @key="week">
                                @if (_heldWeeks > 1)
                                {
                                    <p class="@($"mb-1.5 text-xs {(week == _now ? "font-semibold text-[var(--ui-ink)]" : "text-[var(--ui-muted)]")}")">
                                        Week @(week + 1)@(week == _now ? " · now" : "")
                                    </p>
                                }
                                <ShiftChips Rows="Rows.Where(r => r.WeekIndex == week).ToList()" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-[var(--ui-muted)]">@(ReadOnly ? "No locked shifts." : "No locked shifts yet - tick the days below and save.")</p>
                }
                @if (Over)
                {
                    <p class="mt-3 text-xs font-medium text-[var(--ui-amber-ink)]">
                        ⚠ This fixed roster pays @Js.ToFixed(FixedPaid, 1)h/fortnight, above the @(Js.NumberToString(Employee.ContractHours))h contract.
                    </p>
                }
            </Card>

            @if (!ReadOnly)
            {
                <Card Class="!p-4">
                    <SectionHeader>
                        <Title>@(_has ? "Edit the pattern" : "Set a weekly pattern")</Title>
                    </SectionHeader>
                    <p class="mb-3 text-xs text-[var(--ui-muted)]">
                        Tick the locked days and enter 24-hour start and finish times. A 2- or 4-week cycle repeats its weeks in
                        order from the start date.
                    </p>
                    <div class="mb-3 flex flex-wrap items-end gap-3">
                        <div>
                            <span class="@Ui.FieldLabelClass">Cycle length</span>
                            <div class="flex gap-1">
                                @foreach (var n in TeamRules.CycleChoices)
                                {
                                    <button @key="n" type="button" aria-pressed="@(_weeks == n ? "true" : "false")" @onclick="() => PickWeeks(n)" class="@Seg(_weeks == n)">
                                        @n week@(n > 1 ? "s" : "")
                                    </button>
                                }
                            </div>
                        </div>
                        @if (_weeks > 1)
                        {
                            <label>
                                <span class="@Ui.FieldLabelClass">Week 1 starts</span>
                                <input type="date" value="@_startDate" @oninput="e => _startDate = e.Value?.ToString() ?? string.Empty" class="@Ui.FieldClass" />
                            </label>
                        }
                    </div>
                    @if (_weeks > 1 && IsDate(_startDate))
                    {
                        <p class="mb-3 text-xs text-[var(--ui-muted)]">
                            Week 1 is the week beginning Monday @Dates.AuShort(FixedCycle.MondayOf(ParseDate(_startDate))); the cycle repeats every @_weeks weeks from
                            there.
                        </p>
                    }
                    @if (_weeks > 1)
                    {
                        <div class="mb-2 flex flex-wrap items-center gap-1">
                            @for (var w = 0; w < _weeks; w++)
                            {
                                var week = w;
                                <button @key="week" type="button" aria-pressed="@(_week == week ? "true" : "false")" @onclick="() => _week = week" class="@Seg(_week == week, true)">
                                    Week @(week + 1)
                                </button>
                            }
                            @if (_week > 0)
                            {
                                <button type="button" @onclick="CopyWeekOne" class="@($"ml-auto text-xs {Ui.LinkClass}")" title="Copy Week 1's days and times into this week">
                                    Copy from Week 1
                                </button>
                            }
                        </div>
                    }
                    <div class="space-y-1.5">
                        @for (var i = 0; i < 7; i++)
                        {
                            var day = i;
                            var cell = _grid[_week][day];
                            var d = Period.DayLabels[day];
                            <div @key="day" class="flex items-center gap-2">
                                <label class="flex w-16 items-center gap-1.5 text-sm font-medium text-[var(--ui-ink)]">
                                    <input type="checkbox" checked="@cell.On" @onchange="e => cell.On = e.Value is true" />
                                    @d
                                </label>
                                <input type="time" aria-label="@($"{d} start")" value="@cell.Start" disabled="@(!cell.On)"
                                       @oninput="e => cell.Start = e.Value?.ToString() ?? string.Empty" class="@($"{Ui.FieldClass} !px-2 !py-1 disabled:opacity-40")" />
                                <span class="text-[var(--ui-muted)]">–</span>
                                <input type="time" aria-label="@($"{d} finish")" value="@cell.End" disabled="@(!cell.On)"
                                       @oninput="e => cell.End = e.Value?.ToString() ?? string.Empty" class="@($"{Ui.FieldClass} !px-2 !py-1 disabled:opacity-40")" />
                            </div>
                        }
                    </div>
                    @if (_err is not null)
                    {
                        <p class="mt-3 text-sm text-[var(--ui-bad)]" role="alert">@_err</p>
                    }
                </Card>
            }
        </div>
    </ChildContent>
</SideSheet>

@code {
    private sealed class DayEdit
    {
        public bool On { get; set; }
        public string Start { get; set; } = "";
        public string End { get; set; } = "";

        public DayEdit Copy() => new() { On = On, Start = Start, End = End };
    }

    private bool _has;
    private int _heldWeeks;
    private int _now;
    private int _weeks;
    private string _startDate = "";
    private DayEdit[][] _grid = [];
    private int _week;
    private string? _err;
    private bool _busy;

    [Parameter, EditorRequired] public TeamMember Employee { get; set; } = default!;

    /// <summary>The person's locked shifts, every week of the cycle.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<FixedShift> Rows { get; set; } = [];

    [Parameter] public FixedRosterCycleRow? Cycle { get; set; }

    /// <summary>The fixed roster's paid hours a fortnight (Team Members works it out).</summary>
    [Parameter] public double FixedPaid { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Today in the person's own time zone.</summary>
    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    protected override void OnInitialized()
    {
        _heldWeeks = Cycle?.CycleWeeks ?? 1;
        _weeks = _heldWeeks;
        // Week 1 defaults to the current week, which is what "starting now" means.
        _startDate = (Cycle?.StartDate ?? FixedCycle.MondayOf(Today)).ToIso();
        _grid = Enumerable.Range(0, 4).Select(w => Enumerable.Range(0, 7).Select(i =>
        {
            var row = Rows.FirstOrDefault(f => f.WeekIndex == w && f.DayOfWeek == i);
            return new DayEdit { On = row is not null, Start = row is null ? "" : TeamRules.Hm(row.StartTime), End = row is null ? "" : TeamRules.Hm(row.EndTime) };
        }).ToArray()).ToArray();
    }

    protected override void OnParametersSet()
    {
        _has = Rows.Count > 0;
        _heldWeeks = Cycle?.CycleWeeks ?? 1;
        _now = Cycle is not null ? FixedCycle.FixedWeekIndex(_heldWeeks, Cycle.StartDate, Today) : 0;
    }

    // "Week 1 from 03/08", for a multi-week cycle that is held.
    private RenderFragment? LockedAside => _has && _heldWeeks > 1 && Cycle is { } c
        ? b => b.AddContent(0, $"Week 1 from {Dates.AuShort(c.StartDate)}")
        : null;

    private bool Over => _has && Employee.Role != "JSA" && FixedPaid > Employee.ContractHours + 0.01;

    private static string Seg(bool on, bool accent = false) =>
        $"rounded-lg px-3 py-1.5 text-sm font-semibold {Ui.FocusRing} " +
        (on
            ? accent ? "bg-[var(--brand-orange)] text-white" : "bg-[var(--ui-ink)] text-white"
            : "bg-[var(--ui-lavender)] text-[var(--ui-ink)] hover:bg-[var(--ui-lavender-strong)]");

    private static bool IsDate(string s) => DateOnly.TryParseExact(s, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out _);

    private static DateOnly ParseDate(string s) => DateOnly.ParseExact(s, "yyyy-MM-dd", CultureInfo.InvariantCulture);

    private void PickWeeks(int n)
    {
        _weeks = n;
        if (_week >= n) _week = 0;
    }

    private void CopyWeekOne() => _grid[_week] = _grid[0].Select(c => c.Copy()).ToArray();

    // The same checks the pattern dialog made before saving; the server then applies the
    // shift rules (owner decision R6) and says why if it refuses.
    private async Task SaveAsync()
    {
        if (!IsDate(_startDate))
        {
            _err = "Enter the date Week 1 starts.";
            return;
        }
        var days = new List<FixedDay>();
        for (var w = 0; w < _weeks; w++)
        {
            for (var i = 0; i < 7; i++)
            {
                var r = _grid[w][i];
                if (!r.On) continue;
                var label = _weeks > 1 ? $"Week {w + 1} {Period.DayLabels[i]}" : Period.DayLabels[i];
                if (r.Start == "" || r.End == "")
                {
                    _err = $"Enter both times for {label} (or untick it).";
                    return;
                }
                if (string.CompareOrdinal(r.Start, r.End) >= 0)
                {
                    _err = $"{label}: start must be before end.";
                    return;
                }
                days.Add(new FixedDay(w, i, TimeOnly.Parse(r.Start, CultureInfo.InvariantCulture), TimeOnly.Parse(r.End, CultureInfo.InvariantCulture)));
            }
        }
        _err = null;
        _busy = true;
        var res = await Team.SetFixedRosterCycleAsync(Employee.Id, _weeks, ParseDate(_startDate), days);
        _busy = false;
        if (!res.Ok)
        {
            _err = res.Error ?? "The fixed roster could not be saved.";
            return;
        }
        await OnSaved.InvokeAsync();
    }

    private async Task ClearAsync()
    {
        if (!await Browser.ConfirmAsync($"Clear {Employee.Name}'s fixed roster? Every locked shift and the cycle go.")) return;
        _busy = true;
        var res = await Team.ClearFixedRosterAsync(Employee.Id);
        _busy = false;
        if (!res.Ok)
        {
            _err = res.Error ?? "The fixed roster could not be cleared.";
            return;
        }
        await OnSaved.InvokeAsync();
    }
}
