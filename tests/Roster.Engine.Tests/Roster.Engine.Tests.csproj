<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Roster.Engine\Roster.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test vectors produced by V8: node Core/js-vectors.mjs Core/js-vectors.json -->
    <None Include="Core\js-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Planning vectors produced by the TypeScript app: node Planning/planning-vectors.mjs Planning/planning-vectors.json -->
    <None Include="Planning\planning-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
